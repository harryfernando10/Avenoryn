# Secrets
.env
.env.local
.env.*.local
frontend/.env
backend/.env
backend/.e2e-private-storage/
frontend/test-results/
frontend/playwright-report/
frontend/.cache/

# Prisma local artifacts (migrations are committed; client lives in node_modules)
backend/prisma/*.db
backend/prisma/*.db-journal

# Dependencies
node_modules/
.venv/
__pycache__/

# Builds
frontend/dist/
backend/dist/

# Logs and caches
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vite/
*.tsbuildinfo

# Private user files (never commit real documents)
private-storage/**
!private-storage/.gitkeep

# Tooling
.idea/
.vscode/
coverage/
